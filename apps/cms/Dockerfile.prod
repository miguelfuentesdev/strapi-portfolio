# ---------- deps ----------
FROM node:22-alpine AS deps
RUN apk add --no-cache \
  build-base gcc autoconf automake zlib-dev libpng-dev nasm bash vips-dev git

RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

WORKDIR /opt/app

# Copiamos manifests para cache
COPY package.json pnpm-lock.yaml* ./

# Instala todas las deps (necesarias para build)
RUN pnpm install --frozen-lockfile


# ---------- build ----------
FROM deps AS build
WORKDIR /opt/app

# Copiamos el resto del proyecto
COPY . .

# Build de Strapi (admin panel + build artifacts)
RUN pnpm build

# Deja solo deps de producción
RUN pnpm prune --prod


# ---------- runtime ----------
FROM node:22-alpine AS runtime
# sharp trae su propia libvips precompilada; no hace falta vips del sistema

# Lambda Web Adapter: solo se activa dentro de AWS Lambda.
# En Docker/EC2 la imagen arranca igual que antes.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

ENV NODE_ENV=production \
  # En Lambda solo /tmp es escribible
  HOME=/tmp \
  STRAPI_TELEMETRY_DISABLED=true \
  STRAPI_DISABLE_UPDATE_NOTIFICATION=true \
  AWS_LWA_PORT=1337 \
  AWS_LWA_READINESS_CHECK_PATH=/_health \
  # Strapi tarda más que el límite de 10 s del init de Lambda
  AWS_LWA_ASYNC_INIT=true

WORKDIR /opt/app

# Usuario no-root. --chown evita duplicar la app en una capa extra con chown -R
RUN addgroup -S nodegrp && adduser -S nodeusr -G nodegrp
# tsconfig.json le indica a Strapi que cargue la app compilada desde dist/
COPY --from=build --chown=nodeusr:nodegrp /opt/app/package.json /opt/app/tsconfig.json /opt/app/favicon.png ./
COPY --from=build --chown=nodeusr:nodegrp /opt/app/node_modules ./node_modules
COPY --from=build --chown=nodeusr:nodegrp /opt/app/dist ./dist
COPY --from=build --chown=nodeusr:nodegrp /opt/app/public ./public
COPY --from=build --chown=nodeusr:nodegrp /opt/app/database ./database
# Fuentes .ts: strapi start lee tsconfig.json y falla si no encuentra inputs
COPY --from=build --chown=nodeusr:nodegrp /opt/app/src ./src
COPY --from=build --chown=nodeusr:nodegrp /opt/app/config ./config
COPY --from=build --chown=nodeusr:nodegrp /opt/app/types ./types
RUN mkdir -p public/uploads .cache .tmp && chown nodeusr:nodegrp public/uploads .cache .tmp

USER nodeusr

EXPOSE 1337
CMD ["node", "./node_modules/@strapi/strapi/bin/strapi.js", "start"]
